# Copy to .env for local dev. Real secrets live in ~/Claude/keys/dreamland.env
# and are symlinked as .env in the project root.

# Neon Postgres. Pooled URL for the app runtime, direct URL for Prisma migrations.
DATABASE_URL="postgresql://user:pass@ep-example-pooler.eu-central-1.aws.neon.tech/dreamland?sslmode=require"
DIRECT_URL="postgresql://user:pass@ep-example.eu-central-1.aws.neon.tech/dreamland?sslmode=require"

# Session-cookie signing (manager auth). Generate with `openssl rand -hex 32`.
AUTH_SECRET="change_me_32_bytes_hex"

# Canonical base URL burned into every printed QR code.
# FROZEN — see docs/qr-stability.md. Changing this invalidates every QR the park
# has printed on signs and bracelets. Do not change without a reprint plan.
QR_BASE_URL="https://wave-republic.vercel.app"

# Vercel Blob store for menu-item photos. MUST be a PUBLIC store — guests fetch
# these URLs with no session, and a private store returns 403 for them.
# Named to match the vars Vercel generates for the "blob_images" store.
blob_images_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxx"

# Phase 2 toggle. Leave "false" until wallet + orders are ready.
NEXT_PUBLIC_PHASE_2_ENABLED="false"
