// Dreamland — Postgres schema
// Guideline: no permanent deletes for user-facing entities; use `active` flags.
// Order line items live on the order as JSON to keep prices stable across
// menu edits (a re-priced item shouldn't change past orders).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  owner
  manager
  cashier
}

enum VenueType {
  restaurant
  kiosk
}

enum Fulfillment {
  delivery
  pickup
}

enum OrderStatus {
  confirmed
  preparing
  ready
  delivering
  delivered
  picked_up
  cancelled
}

/// Zones have NO user interface as of 2026-08-17 — the backoffice section and every
/// guest-facing mention (map legend, menu location pin, venue cards, reports chart)
/// were removed at Elias's request. The model is retained deliberately:
/// `Restaurant.zoneId` is a required FK, and Phase 2 needs zones for sunbed-delivery
/// destinations plus the ZoneSession anti-scam gate. New venues attach silently to
/// the default zone (see src/lib/venueActions.ts). Do not surface zones in the UI
/// again without asking.
model Zone {
  id        String   @id                       // "A", "B", …
  name      String                             // "Wave Pool"
  code      String   @unique                   // "DL-WAVE-01" — printed on the sign
  color     String                             // "#0BA5E9"
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurants Restaurant[]
  orders      Order[]      @relation("OrderDeliveryZone")
  sessions    ZoneSession[]
}

model Restaurant {
  id           String    @id                   // "grill", "tacos", …
  name         String
  type         VenueType
  cuisine      String
  zoneId       String
  prep         Int                              // minutes
  rating       Float
  // Customer map removed 2026-08-18; these three survive with no customer UI.
  // Kept so restoring the map is a revert, not a rebuild. Still written on
  // create (see venueActions) so the data stays valid. Do not drop, do not
  // build UI on them without asking.
  pinColor     String                           // auto-assigned from a palette; no UI picker
  mapX         Int                              // 0-100 (%)
  mapY         Int
  thumbLabel   String                           // "burgers", "tacos", … — caption + fallback when imageUrl is null
  imageUrl     String?                          // venue photo (Vercel Blob); fills browse tile, menu banner, backoffice card
  qrSlug       String?   @unique                 // short URL slug for direct-menu QR (e.g. "wave-cafe")
  active       Boolean   @default(true)
  sortOrder    Int       @default(0)             // browse-screen order; manager drag-and-drop
  deliveryEnabled Boolean @default(true)         // Phase 2 only — no UI, always true for now
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  zone          Zone            @relation(fields: [zoneId], references: [id])
  categoryLinks CategoryVenue[]
  tags          VenueTag[]
  orders        Order[]
  staff         Staff[]
}

/// A category is shared across venues via CategoryVenue — it has no owning
/// restaurant. Migrated from a per-venue model 2026-08-18; see docs/catalog-plan.md.
model MenuCategory {
  id        String   @id @default(cuid())
  name      String
  slot      String                               // "food" | "drinks" | "sweets" — browse filter, see docs/catalog-plan.md
  sortOrder Int      @default(0)                 // fallback order; per-venue order lives on CategoryVenue
  active    Boolean  @default(true)

  venues    CategoryVenue[]
  itemLinks ItemCategory[]
}

/// Which venues serve a category, and where it sits in that venue's menu.
/// sortOrder is per-pairing: the same category can sit 1st at one venue, 4th at another.
model CategoryVenue {
  categoryId   String
  restaurantId String
  sortOrder    Int    @default(0)

  category   MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  restaurant Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@id([categoryId, restaurantId])
  @@index([restaurantId, sortOrder])
}

/// Which categories an item appears in, and its position inside each.
/// An item in two of a venue's categories shows up in both — intended.
model ItemCategory {
  itemId     String
  categoryId String
  sortOrder  Int    @default(0)

  item     MenuItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  category MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([itemId, categoryId])
  @@index([categoryId, sortOrder])
}

/// An item reaches venues through its categories, not directly. Price is global
/// (one price everywhere) — per-venue pricing would be a new join table, not a
/// change here. See docs/catalog-plan.md.
model MenuItem {
  id          String  @id @default(cuid())
  name        String
  description String?
  imageUrl    String?                            // public Vercel Blob URL; null = placeholder tile
  priceCents  Int                                // global price — same at every venue that serves it
  available   Boolean @default(true)
  active      Boolean @default(true)

  categories ItemCategory[]
  tags       ItemTag[]
}

/// Manager-defined labels ("Chef's choice", "Most popular"), shown as chips.
model Tag {
  id        String  @id @default(cuid())
  name      String  @unique
  color     String                               // chip background
  sortOrder Int     @default(0)
  active    Boolean @default(true)
  createdAt DateTime @default(now())

  items  ItemTag[]
  venues VenueTag[]
}

model ItemTag {
  itemId String
  tagId  String

  item MenuItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  tag  Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([itemId, tagId])
}

model VenueTag {
  restaurantId String
  tagId        String

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tag        Tag        @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([restaurantId, tagId])
}

model Staff {
  id         String   @id @default(cuid())
  username   String   @unique
  passwordHash String
  name       String
  role       Role
  kioskId    String?
  active     Boolean  @default(true)
  removable  Boolean  @default(true)          // guards the seeded owner/manager
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  kiosk    Restaurant? @relation(fields: [kioskId], references: [id])
  sessions StaffSession[]
}

model StaffSession {
  id        String   @id @default(cuid())
  staffId   String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

/// Zone-session issued when a customer scans a QR. Ordering is blocked
/// without a valid, unexpired zone session bound to their phone.
model ZoneSession {
  id        String   @id @default(cuid())
  zoneId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  zone Zone @relation(fields: [zoneId], references: [id])

  @@index([expiresAt])
}

model Order {
  id                String       @id            // formatted "1043", "1044" … stable per README
  restaurantId      String
  fulfillment       Fulfillment
  deliveryZoneId    String?
  status            OrderStatus  @default(confirmed)
  items             Json                        // [{ id, name, priceCents, qty }]
  subtotalCents     Int
  serviceFeeCents   Int          @default(0)
  deliveryFeeCents  Int          @default(0)
  totalCents        Int
  prepMinutes       Int
  placedAt          DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  paymentIntentId   String?                     // stripe (null while mocked)
  paymentStatus     String       @default("mocked_succeeded")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  zone       Zone?      @relation("OrderDeliveryZone", fields: [deliveryZoneId], references: [id])

  @@index([restaurantId, status])
  @@index([placedAt])
}

/// Monotonic sequence for human-friendly order numbers ("1043", "1044").
/// Prototype starts at 1043 (nextId in the design).
model OrderSequence {
  id      Int @id @default(1)
  nextVal Int @default(1043)
}

/// Phase 1 analytics — track anonymous visitor engagement with the menu.
/// entityType: "restaurant" | "item" | "map_pin"
/// source: "park" | "bracelet" | "resto" | "direct" (from ?src= on QR entry)
/// Dedup enforced in application code (30-min window per visitor+entity).
model PageView {
  id         String   @id @default(cuid())
  visitorId  String
  entityType String
  entityId   String
  source     String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([visitorId, createdAt])
}
